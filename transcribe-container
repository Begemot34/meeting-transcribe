#!/usr/bin/env bash
# Run ./transcribe inside Podman: same commands and arguments, paths as on the host —
# the current directory is bind-mounted where it is, models download once into the
# named volume mt-cache (podman volume rm mt-cache clears them).
#
# Build the image and download the models once:
#   ./transcribe-container setup --language ru,en --summary none --yes
# Transcribe a recording (run from the folder that holds it):
#   ./transcribe-container auto meeting.mp4 out/board-1105
# NVIDIA GPU: build the cuda image once, MT_DEVICE=cuda turns recognition onto it:
#   ./transcribe-container --cuda setup --language ru,en --summary none --yes
#   MT_DEVICE=cuda ./transcribe-container --cuda auto meeting.mp4 out/board-1105
# Summary via a local Ollama on the host: set OLLAMA_HOST=http://host.containers.internal:11434
# As a service (inbox ./data/inbox, web UI at http://127.0.0.1:8080/, Ctrl+C stops it):
#   ./transcribe-container serve
# for a service that restarts on its own and listens on the network use compose.yaml instead
#
# Flags before the transcribe command:
#   --cuda       image localhost/meeting-transcribe:cuda + the host GPU (nvidia.com/gpu=all)
#   --image NAME run another image
#   --build      rebuild the image first
#   --pull       podman pull the image first (a localhost image cannot be pulled — use --build)
#   --build and --pull: use one, not both
#   A foreign --image (not localhost/meeting-transcribe*) gets no MT_LLM_API_KEY/HF_TOKEN/MT_SERVE_TOKEN/AWS_*
set -euo pipefail
[ "$(uname -s)" = Linux ] || { printf 'transcribe-container: Linux only; on macOS run ./transcribe directly\n' >&2; exit 2; }

IMAGE="localhost/meeting-transcribe:latest"
BUILD=0 PULL=0 IMAGE_SET=0 CUDA=0
GPU=()
while [ $# -gt 0 ]; do
  case "$1" in
    --cuda)
      CUDA=1
      GPU=(--device nvidia.com/gpu=all)
      if [ "$IMAGE_SET" = 0 ]; then IMAGE="localhost/meeting-transcribe:cuda"; fi ;;
    --image) [ $# -ge 2 ] || { printf 'transcribe-container: --image needs a name\n' >&2; exit 2; }
             IMAGE_SET=1; IMAGE="$2"; shift ;;
    --build) BUILD=1 ;;
    --pull) PULL=1 ;;
    -*) printf 'transcribe-container: unknown flag %s\n' "$1" >&2; exit 2 ;;
    *) break ;;
  esac
  shift
done
if [ "$BUILD" = 1 ] && [ "$PULL" = 1 ]; then
  printf 'transcribe-container: use --build or --pull, not both\n' >&2
  exit 2
fi

# podman cannot parse a "-v src:dst" whose source contains a colon: fail before running anything
case "$PWD" in
  *:*) printf 'transcribe-container: the current directory contains ":", podman cannot mount it (-v src:dst) — run from a path without colons\n' >&2; exit 2 ;;
esac

# the container mounts only the current directory: positional paths that resolve outside it would
# have their results written to an unmounted path and lost with --rm — stop before any build or pull
PDIR="$(pwd -P)"
case "${1:-}" in
  auto|asr|frames|badges|strip|merge) npaths=2 ;;
  export|summarize) npaths=1 ;;
  *) npaths=0 ;;
esac
# serve: the data folder must be under the mounted directory too; it is passed in as an absolute path
SERVE=()
if [ "${1:-}" = serve ]; then
  data="$(realpath -m -- "${MT_SERVE_DATA:-data}" 2>/dev/null || printf '%s' "${MT_SERVE_DATA:-data}")"
  case "$data" in
    "$PDIR"/*) ;;
    *) printf 'transcribe-container: MT_SERVE_DATA=%s resolves outside the current directory — the container mounts only it\n' "$data" >&2; exit 2 ;;
  esac
  for arg in "${@:2}"; do
    case "$arg" in --data|--data=*|--port|--port=*|--host|--host=*) printf 'transcribe-container: serve takes the data folder and the port from MT_SERVE_DATA and MT_SERVE_PORT here, not from %s\n' "$arg" >&2; exit 2 ;; esac
  done
  mkdir -p "$data/inbox"
  export MT_SERVE_DATA="$data"
  port="${MT_SERVE_PORT:-8080}"
  # --init reaps the pipeline's children; only this machine reaches the port
  SERVE=(--init -p "127.0.0.1:$port:$port")
fi
if [ "$npaths" -gt 0 ]; then
  skip="" pos=0
  for arg in "${@:2}"; do
    if [ -n "$skip" ]; then skip=""; continue; fi
    case "$arg" in
      --title|--date|--language|--summary|--model|--llm|--max-speakers|--threshold|--min-gap|--crop|--share-start|--per-speaker|--probe|--duration|--speakers|--width|--quality|--merge-gap) skip=1 ;;
      --*) ;;
      *)
        pos=$((pos + 1))
        if [ "$pos" -le "$npaths" ]; then
          p="$(realpath -m -- "$arg" 2>/dev/null || printf '%s' "$arg")"
          case "$p" in
            "$PDIR"|"$PDIR"/*) ;;
            *) printf 'transcribe-container: %s resolves outside the current directory — the container mounts only it; run from the folder that holds the recording and output\n' "$arg" >&2; exit 2 ;;
          esac
        fi ;;
    esac
  done
fi

# setup settings live on the cache volume next to the models, never a host path: the container's
# config.env stays inside the volume and cannot shadow the host file
export MT_CONFIG=/cache/config.env

# --cuda implies the cuda device — unless the user picked an image or a device themselves
if [ "$CUDA" = 1 ] && [ "$IMAGE_SET" = 0 ]; then
  export MT_DEVICE="${MT_DEVICE:-cuda}"
fi
case "${MT_DEVICE:-}" in
  cuda)
    case "$IMAGE" in
      *:cuda) ;;
      *) printf 'transcribe-container: MT_DEVICE=cuda needs a cuda image — run with --cuda\n' >&2; exit 2 ;;
    esac ;;
esac

# the torch build follows the image tag, not the flag: a cuda-tagged image is built with cuda torch
case "$IMAGE" in
  *:cuda)
    BUILD_DEVICE=cuda
    # a cuda-tagged image runs on the GPU: without the host GPU device the run fails mid-way;
    # an explicit MT_DEVICE=cpu is the one way to use it without the GPU
    if [ "${MT_DEVICE:-}" != cpu ]; then GPU=(--device nvidia.com/gpu=all); fi ;;
  *) BUILD_DEVICE=cpu ;;
esac

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

if [ "$PULL" = 1 ]; then podman pull "$IMAGE"; fi
if [ "$BUILD" = 1 ]; then
  podman build \
    --build-arg "DEVICE=$BUILD_DEVICE" \
    --build-arg "UID=$(id -u)" --build-arg "GID=$(id -g)" \
    -t "$IMAGE" "$HERE"
elif ! podman image exists "$IMAGE"; then
  case "$IMAGE" in
    localhost/meeting-transcribe | localhost/meeting-transcribe:*)
      podman build \
        --build-arg "DEVICE=$BUILD_DEVICE" \
        --build-arg "UID=$(id -u)" --build-arg "GID=$(id -g)" \
        -t "$IMAGE" "$HERE" ;;
    *) printf 'transcribe-container: image %s is not here — podman pull it first (--pull), or build it with --build\n' "$IMAGE" >&2; exit 1 ;;
  esac
fi

# trusted images share the mt-cache volume; a foreign image gets its own mt-cache-foreign, so its
# runs can neither read the trusted config.env on the cache volume, nor write into the trusted
# model cache; the repo directory is still mounted as-is — run foreign images from a folder
# without config.env
VOL=mt-cache
case "$IMAGE" in localhost/meeting-transcribe | localhost/meeting-transcribe:*) ;; *) VOL=mt-cache-foreign ;; esac
podman volume exists "$VOL" || podman volume create "$VOL"

# MT_*/HF_* settings, the Ollama address, proxies and the pyannote metrics switch follow the
# shell into the container; variables that are not set are not passed at all.
# Secrets (MT_LLM_API_KEY, HF_TOKEN, MT_SERVE_TOKEN, AWS_* of serve) go only to localhost/meeting-transcribe images.
TRUSTED=1
case "$IMAGE" in localhost/meeting-transcribe | localhost/meeting-transcribe:*) ;; *) TRUSTED="" ;; esac

ENV_FLAGS=()
SKIPPED=""
while IFS='=' read -r name _; do
  case "$name" in
    MT_*|HF_*|OLLAMA_HOST|HTTPS_PROXY|HTTP_PROXY|NO_PROXY|PYANNOTE_METRICS_ENABLED|TZ) ;;
    AWS_ACCESS_KEY_ID|AWS_SECRET_ACCESS_KEY|AWS_SESSION_TOKEN) [ "${1:-}" = serve ] || continue ;;
    *) continue ;;
  esac
  case "$name" in
    # the image points these caches at /cache; a host value would shadow the volume layout
    HF_HOME | HF_HUB_CACHE | MT_EASYOCR_DIR) continue ;;
  esac
  if [ -z "$TRUSTED" ] && case "$name" in MT_LLM_API_KEY|HF_TOKEN|MT_SERVE_TOKEN|AWS_*) true ;; *) false ;; esac; then
    SKIPPED="$SKIPPED $name"
    continue
  fi
  ENV_FLAGS+=(--env "$name")
done < <(env)
[ -z "$SKIPPED" ] || printf 'transcribe-container:%s not passed into %s — secrets go only to localhost/meeting-transcribe images\n' "$SKIPPED" "$IMAGE" >&2

# -it only when the input is a terminal, so logs and pipes work without one
TTY=()
if [ -t 0 ]; then TTY=(-it); fi

# label=disable: rootless single-user host + CDI GPU, per podman docs; on a shared host reconsider
exec podman run --rm \
  "${TTY[@]}" \
  --userns=keep-id \
  --security-opt label=disable \
  "${GPU[@]}" \
  "${SERVE[@]}" \
  -v "$VOL:/cache" \
  -v "$PWD:$PWD" \
  -w "$PWD" \
  "${ENV_FLAGS[@]}" \
  "$IMAGE" "$@"
